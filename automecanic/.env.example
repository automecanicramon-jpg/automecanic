# ============================================================
# CONFIGURACIÓN DE NOTIFICACIONES POR CORREO (BREVO)
# ============================================================

# 1. Tu API Key v3 de Brevo (inicia normalmente con xkeysib-...)
#    Obténla en: Brevo Dashboard -> SMTP & API -> Claves API -> Generar una nueva clave API
VITE_BREVO_API_KEY=xkeysib-tu_api_key_aqui

# 2. Correo del remitente registrado y verificado en Brevo
#    Debe ser un correo verificado en: Brevo Dashboard -> Remitentes e IP -> Remitentes
VITE_BREVO_SENDER_EMAIL=notificaciones@tudominio.com

# 3. Nombre del remitente que aparecerá en el correo recibido
VITE_BREVO_SENDER_NAME=AutoMecanic Notificaciones

# 4. Correo del administrador que recibirá los avisos de nuevas citas
VITE_ADMIN_EMAIL=admin@taller.com
